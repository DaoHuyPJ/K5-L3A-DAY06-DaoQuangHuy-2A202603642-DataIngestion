
# Local embedding model (Sentence Transformers). No API key needed.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional: where Hugging Face caches the model (~0.5 GB). Leave empty for the default.
HF_HOME=
# Optional: folder with a pre-downloaded copy of EMBEDDING_MODEL (must contain modules.json + REVISION)
EMBEDDING_MODEL_PATH=

# Not used by this solution (local model). Leave empty.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
